{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "server.js",
    "src/**/*.js",
    "worker/**/*.mjs",
    "scripts/**/*.mjs",
    "tests/**/*.js",
    "public/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "worker/assets.generated.mjs"]
}
