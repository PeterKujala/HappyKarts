{
  "name": "kartboard",
  "version": "0.4.0",
  "private": true,
  "description": "KartBoard practice-session board for a local club network or designacle.au",
  "scripts": {
    "start": "node server.js",
    "pretest": "node scripts/embed-assets.mjs",
    "test": "node --test",
    "pretypecheck": "node scripts/embed-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "prebuild": "node scripts/embed-assets.mjs",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "users": "node scripts/manage-users.mjs",
    "qr": "node scripts/generate-qr.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.166.0"
  }
}
